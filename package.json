{
  "name": "vscode-glorious-icons",
  "displayName": "Glorious Icons",
  "description": "Icon pack for VSCode",
  "publisher": "klaseca",
  "version": "0.0.5",
  "author": "Maxim Molochkov <klaseca@gmail.com> (https://github.com/klaseca)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/klaseca/vscode-glorious-icons",
  "icon": "./assets/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/klaseca/vscode-glorious-icons.git"
  },
  "bugs": {
    "url": "https://github.com/klaseca/vscode-glorious-icons/issues"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "icons",
    "theme",
    "material",
    "icon-theme"
  ],
  "engines": {
    "vscode": "^1.36.0"
  },
  "contributes": {
    "iconThemes": [
      {
        "id": "glorious-dark",
        "label": "Glorious Dark",
        "path": "./dist/dark/index.json"
      }
    ]
  },
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.11.0"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11"
    }
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier -w .",
    "typecheck": "tsc --noEmit",
    "build": "node ./src/build.ts",
    "vscode:prepublish": "npm run build",
    "package": "vsce package",
    "release": "bumpp"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "3.4.2",
    "@types/node": "22.15.19",
    "@vscode/vsce": "4.0.0",
    "bumpp": "12.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
